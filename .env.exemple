# Copier ce fichier en « .env » puis renseigner les valeurs du projet Supabase
# (tableau de bord Supabase > Project Settings > API).
# Seules les variables préfixées par VITE_ sont exposées au navigateur. La clé
# « anon » est publique par nature : c'est le RLS qui protège les données.

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_CLE_ANON=cle-publique-anon
